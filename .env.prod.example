# ===== PRODUCTION env =====
# Copy to .env.prod and fill in REAL values, then deploy with:
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml --env-file .env.prod up -d
#
# Everything that was hardcoded to localhost in dev is a variable here.

# ---- Public URLs (your real domains, HTTPS) ----
# The app's public URL (where users browse).
APP_PUBLIC_URL=https://chat.example.com
# Keycloak's public URL (what the browser is redirected to for login).
KEYCLOAK_PUBLIC_URL=https://auth.example.com
# The realm issuer = KEYCLOAK_PUBLIC_URL + /realms/aichat
KEYCLOAK_ISSUER=https://auth.example.com/realms/aichat
# How the BFF reaches Keycloak server-to-server (internal service or same URL).
# If Keycloak is in THIS compose, use the service name: http://keycloak:8080/realms/aichat
KEYCLOAK_INTERNAL_URL=http://keycloak:8080/realms/aichat

# ---- HTTPS / cookies ----
# MUST be true in production (cookie only sent over TLS).
COOKIE_SECURE=true

# ---- Secrets (generate strong random values!) ----
# e.g. openssl rand -hex 32
SESSION_SECRET=CHANGE_ME_long_random_hex
KEYCLOAK_CLIENT_SECRET=CHANGE_ME_strong_client_secret
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_strong_admin_password

# ---- Pre-built images (built in CI, pulled on the server) ----
# Set these to your registry tags; the prod compose pulls instead of building.
IMAGE_FRONTEND=your-registry/aichat-frontend:latest
IMAGE_BFF=your-registry/aichat-bff:latest
IMAGE_AIBACKEND=your-registry/aichat-aibackend:latest

# ---- aiBackend / model ----
OPENROUTER_API_KEY=sk-or-...
DEFAULT_MODEL=nvidia/nemotron-3-super-120b-a12b
APP_ENV=production

# ---- Observability ----
# In prod prefer LangSmith (cloud) OR a properly-hosted Langfuse URL.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_...
LANGSMITH_PROJECT=multi-agent-supervisor
# If using a hosted Langfuse instead, set these and APP_ENV=development is NOT needed:
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASEURL=
