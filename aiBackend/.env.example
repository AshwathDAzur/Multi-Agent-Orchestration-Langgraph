OPENROUTER_API_KEY=
DEFAULT_MODEL=
PORT=

# Observability switch:
#   development -> traces go to local self-hosted Langfuse
#   production  -> traces go to LangSmith (cloud)
APP_ENV=development

# --- Langfuse (local, used when APP_ENV=development) ---
# Get these from http://localhost:3000 -> Project Settings -> API Keys
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASEURL=

# --- LangSmith tracing (used when APP_ENV=production) ---
# NOTE: LangSmith auto-enables from these env vars. We force it OFF in dev (see
# observability.js) so dev traces don't also hit the cloud.
LANGSMITH_TRACING=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
