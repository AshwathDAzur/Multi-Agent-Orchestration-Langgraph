# ===== multiAgentBoilerplate — local deployment env =====
# Copy to .env and fill in values:  cp .env.example .env

# --- aiBackend / model ---
OPENROUTER_API_KEY=sk-or-...
DEFAULT_MODEL=nvidia/nemotron-3-super-120b-a12b
APP_ENV=development

# --- Keycloak ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
# Must match the secret in keycloak/realm-export.json (bff-client).
KEYCLOAK_CLIENT_SECRET=bff-secret

# --- BFF session ---
# Use a long random string in real deployments.
SESSION_SECRET=change-me-to-a-long-random-string

# --- Observability (optional; traces go to host Langfuse on :3000) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=multi-agent-supervisor
